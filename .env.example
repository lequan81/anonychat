PORT=3000
# Optional comma-separated origins allowed to connect via WebSocket (leave empty or unset to allow all in development)
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5173
RECONNECT_GRACE_SECONDS=120
WS_HEARTBEAT_INTERVAL_SECONDS=15
WS_HEARTBEAT_MISSED_THRESHOLD=3
PAIR_REMATCH_COOLDOWN_SECONDS=15
MESSAGE_LOGGING_ENABLED=true
MESSAGE_LOG_DIR=./logs/messages
ADMIN_PASSWORD=replace-with-a-long-random-secret
